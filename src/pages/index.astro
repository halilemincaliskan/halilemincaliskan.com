---
import Base from '../layouts/Base.astro';
import Rich from '../components/Rich.astro';
import {
  build,
  caseStudy,
  education,
  experience,
  profile,
  skills,
  stats,
  workflow,
} from '../data/site';

const stage = (id: string) => build.stages.find((item) => item.id === id)!;
const terminal = (id: string) => JSON.stringify(stage(id).terminal);
---

<Base>
  <canvas class="scene" data-scene aria-hidden="true"></canvas>

  <header class="bar">
    <div class="bar__progress" aria-hidden="true">
      <span data-progress></span>
    </div>
    <a class="bar__name" href="#top">
      {profile.name}
    </a>

    <div class="island" data-island tabindex="0" aria-label="Build status">
      <div class="island__row">
        <span class="island__pulse" aria-hidden="true"></span>
        <span class="island__stage">
          <span class="island__num" data-island-num>
            00
          </span>
          <span data-island-label>{stage('hero').label}</span>
        </span>
        <ul class="island__gates" aria-label="Checks">
          {build.gates.map((gate) => (
            <li data-gate={gate.id} data-state="pending">
              <i aria-hidden="true" />
              <span>{gate.label}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="island__log" data-island-log aria-hidden="true"></div>
      <p class="sr-only" aria-live="polite" data-island-announce></p>
    </div>

    <nav class="bar__nav" aria-label="Sections">
      <a href="#work">Work</a>
      <a href="#how-i-work">How I work</a>
      <a href="#experience">Experience</a>
      <a href="#contact">Contact</a>
      <a class="bar__cta" href={`mailto:${profile.links.email}`}>
        Email me
      </a>
    </nav>
  </header>

  <!-- Narrow screens: a floating Liquid Glass tab bar, as on iPhone. Icons stand in for SF Symbols. -->
  <nav class="tabs" aria-label="Sections">
    <a href="#work" data-tab="work">
      <!-- briefcase -->
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="7.5" width="17" height="12" rx="2.5"></rect>
        <path d="M9 7.5V6a1.5 1.5 0 011.5-1.5h3A1.5 1.5 0 0115 6v1.5 M3.5 12.5h17"></path>
      </svg>
      <span>Work</span>
    </a>
    <a href="#how-i-work" data-tab="how-i-work">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 6h11M9 12h11M9 18h11"></path>
        <circle cx="4.5" cy="6" r="1.2"></circle>
        <circle cx="4.5" cy="12" r="1.2"></circle>
        <circle cx="4.5" cy="18" r="1.2"></circle>
      </svg>
      <span>How I work</span>
    </a>
    <a href="#experience" data-tab="experience">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5"></circle>
        <path d="M12 7.5V12l3 2"></path>
      </svg>
      <span>Experience</span>
    </a>
    <a href="#contact" data-tab="contact">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="5.5" width="17" height="13" rx="2.5"></rect>
        <path d="M4.5 7.5l7.5 5.5 7.5-5.5"></path>
      </svg>
      <span>Contact</span>
    </a>
  </nav>

  <main id="main">
    <section
      class="chapter chapter--hero"
      id="top"
      data-stage="hero"
      data-terminal={terminal('hero')}
      aria-labelledby="hero-title"
    >
      <div class="copy">
        <p class="kicker reveal">
          {profile.role} · {profile.location}
        </p>
        <h1 id="hero-title" class="display reveal">
          Halil Emin
          <br />
          Çalışkan
        </h1>
        <p class="lede intro reveal">
          <Rich text={profile.summary} />
        </p>
        <p class="note reveal">{profile.availability}</p>
        <div class="actions reveal">
          <a class="button" href={`mailto:${profile.links.email}`}>
            Email me
          </a>
          <a class="textlink" href={profile.links.linkedin}>
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a class="textlink" href={profile.links.github}>
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="hint reveal" aria-hidden="true">
          <span>{build.scrollHint}</span>
          <span class="hint__arrow">↓</span>
        </p>
      </div>
    </section>

    <section
      class="chapter"
      data-stage="stats"
      data-terminal={terminal('stats')}
      aria-labelledby="stats-title"
    >
      <div class="copy">
        <p class="chapter__tag reveal">{stage('stats').label}</p>
        <h2 id="stats-title" class="sr-only">
          In numbers
        </h2>
        <dl class="numbers numbers--row">
          {stats.map((stat) => {
            const target = Number.parseInt(stat.value, 10);
            const suffix = stat.value.endsWith('+') ? '+' : '';
            return (
              <div class="numbers__item reveal">
                <dt>{stat.label}</dt>
                <dd data-count={target} data-suffix={suffix}>
                  {stat.value}
                </dd>
              </div>
            );
          })}
        </dl>
      </div>
    </section>

    <section
      class="chapter chapter--long"
      id="work"
      data-stage="work"
      data-terminal={terminal('work')}
      aria-labelledby="work-title"
    >
      <div class="copy">
        <p class="chapter__tag reveal">Case study · {caseStudy.company}</p>
        <h2 id="work-title" class="headline reveal">
          {caseStudy.title}
        </h2>
        <p class="intro reveal">
          <Rich text={caseStudy.context} />
        </p>
        <ul class="tiles">
          {caseStudy.built.map((item) => (
            <li class="tile reveal">
              <p class="tile__figure">{item.figure}</p>
              <p class="tile__label">{item.label}</p>
              <p class="tile__text">
                <Rich text={item.text} />
              </p>
            </li>
          ))}
        </ul>
        <figure class="quote tile reveal">
          <blockquote>
            <p class="quote__title">{caseStudy.lesson.title}</p>
            <p>{caseStudy.lesson.body}</p>
          </blockquote>
        </figure>
      </div>
    </section>

    <section
      class="chapter chapter--long"
      id="how-i-work"
      data-stage="workflow"
      data-terminal={terminal('workflow')}
      aria-labelledby="workflow-title"
    >
      <div class="copy">
        <p class="chapter__tag reveal">{stage('workflow').label}</p>
        <h2 id="workflow-title" class="headline reveal">
          {workflow.title}
        </h2>
        <p class="intro reveal">
          <Rich text={workflow.intro} />
        </p>
        <ol class="pipeline">
          {workflow.steps.map((step, index) => (
            <li class="reveal">
              <span class="pipeline__node" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>{step.name}</h3>
                <p>
                  <Rich text={step.text} />
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section
      class="chapter chapter--long"
      data-stage="gate"
      data-terminal={terminal('gate')}
      aria-labelledby="gate-title"
    >
      <div class="copy">
        <p class="chapter__tag reveal">{stage('gate').label}</p>
        <h2 id="gate-title" class="headline reveal">
          {workflow.story.title}
        </h2>
        {workflow.story.body.map((paragraph, index) => (
          <p class:list={[index === 0 ? 'intro' : 'body', 'reveal']}>
            <Rich text={paragraph} />
          </p>
        ))}
        <div class="checks reveal" aria-label="Result with the fix reverted">
          <p class="checks__head">
            <code>./verify.sh</code> with the fix reverted
          </p>
          <p class="checks__row checks__row--pass">
            <span aria-hidden="true">✓</span> Simulator build <em>passed</em>
          </p>
          <p class="checks__row checks__row--fail">
            <span aria-hidden="true">✗</span> Device build <em>failed</em>
          </p>
        </div>
      </div>
    </section>

    <section
      class="chapter chapter--long"
      data-stage="defects"
      data-terminal={terminal('defects')}
      aria-labelledby="defects-title"
    >
      <div class="copy">
        <p class="chapter__tag reveal">{stage('defects').label}</p>
        <h2 id="defects-title" class="headline reveal">
          {workflow.defects.title}
        </h2>
        <p class="intro reveal">
          <Rich text={workflow.defects.note} />
        </p>
        <ul class="defects">
          {workflow.defects.items.map((item, index) => (
            <li class="reveal">
              <span class="defects__n">#{index + 1}</span>
              {item}
            </li>
          ))}
        </ul>
        <p class="stamp reveal">{workflow.notDelegated}</p>
      </div>
    </section>

    <section
      class="chapter chapter--long"
      id="experience"
      data-stage="experience"
      data-terminal={terminal('experience')}
      aria-labelledby="experience-title"
    >
      <div class="copy">
        <p class="chapter__tag reveal">{stage('experience').label}</p>
        <h2 id="experience-title" class="headline reveal">
          Experience
        </h2>
        <ol class="timeline">
          {experience.map((entry) => (
            <li class="reveal">
              <p class="timeline__period">{entry.period}</p>
              <h3>
                {entry.role} <span>· {entry.company}</span>
              </h3>
              <ul>
                {entry.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
        <div class="split reveal">
          <div>
            <h3 class="minor">Skills</h3>
            <ul class="chips">
              {skills.production.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
            <ul class="chips chips--quiet" aria-label="Also used">
              {skills.alsoUsed.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="minor">Education</h3>
            <p class="body">
              {education.degree}
              <br />
              <span class="muted">
                {education.school} · {education.year}
              </span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      class="chapter chapter--contact"
      id="contact"
      data-stage="contact"
      data-terminal={terminal('contact')}
      aria-labelledby="contact-title"
    >
      <div class="copy">
        <p class="chapter__tag reveal">{stage('contact').label}</p>
        <h2 id="contact-title" class="success reveal">
          <svg class="success__icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="12" fill="#34c759"></circle>
            <path
              d="M7 12.4l3.3 3.3L17.2 8.6"
              fill="none"
              stroke="#fff"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          {build.successLabel}
        </h2>
        <p class="intro reveal">{profile.availability}</p>
        <ul class="contact-tiles">
          <li class="reveal">
            <a class="tile tile--link tile--wide" href={`mailto:${profile.links.email}`}>
              <span class="tile__label">Email</span>
              <span class="tile__value">{profile.links.email}</span>
              <span class="tile__go" aria-hidden="true">
                ›
              </span>
            </a>
          </li>
          <li class="reveal">
            <a class="tile tile--link" href={profile.links.linkedin}>
              <span class="tile__label">LinkedIn</span>
              <span class="tile__value">Profile</span>
              <span class="tile__go" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
          <li class="reveal">
            <a class="tile tile--link" href={profile.links.github}>
              <span class="tile__label">GitHub</span>
              <span class="tile__value">Code</span>
              <span class="tile__go" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        </ul>
        <p class="footer">
          © {new Date().getFullYear()} {profile.name}
        </p>
      </div>
    </section>
  </main>

  <script src="../scripts/main.ts"></script>
</Base>
